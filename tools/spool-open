#!/bin/sh
# $BROWSER hook for a run-docker.sh launch: the container has no browser,
# so spool the URL into the launch's SLK_SPOOL_DIR for the host bridge
# (tools/host-bridge.py) to open. Write-then-rename so the bridge never
# reads a partial file.
set -eu
tmp="$SLK_SPOOL_DIR/.url-$$"
printf '%s\n' "$1" > "$tmp"
mv "$tmp" "$SLK_SPOOL_DIR/url-$$"
